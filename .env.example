# Copie este arquivo para .env na raiz do projeto e ajuste conforme necessário.

# Usuário e senha do Oracle XE (container local via docker-compose)
ORACLE_USER=system
ORACLE_PASSWORD=Oracle123
ORACLE_DATABASE=XE

# Chave secreta JWT para o backend
JWT_SECRET_KEY=ChangeThisSecret
JWT_EXPIRATION_MS=3600000
